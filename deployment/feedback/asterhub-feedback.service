[Unit]
Description=AsterHub user feedback intake
After=network.target

[Service]
Type=simple
User=asterhub-feedback
Group=asterhub-feedback
ExecStart=/usr/bin/python3 /opt/asterhub-feedback/feedback_api.py --data /var/lib/asterhub-feedback/inbox --port 18772
WorkingDirectory=/opt/asterhub-feedback
StateDirectory=asterhub-feedback
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/asterhub-feedback
MemoryMax=128M
CPUQuota=15%
TasksMax=48
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
